# =============================================
# Database Configuration (PostgreSQL)
# =============================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secret
POSTGRES_DB=hello
# FastAPI gateway runs inside Docker Compose (as a service), use POSTGRES_HOST=postgres (the service name).
DATABASE_URL=postgresql+asyncpg://postgres:secret@localhost:5432/hello

# =============================================
# Authentication & Security
# =============================================
SECRET_KEY="your-strong-secret-key-here"  # Generate with: openssl rand -hex 32
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=1440  # 24 hours

# =============================================
# First Superuser (Initial Setup)
# =============================================
FIRST_SUPERUSER_EMAIL="admin@example.com"
FIRST_SUPERUSER_PASSWORD="ChangeThisSecurePassword123!"
FIRST_SUPERUSER_EMPLOYEE_NUMBER="ADMIN-0000"

# =============================================
# MCP Server Configuration
# =============================================
MCP_SERVER_HOST="localhost"
MCP_SERVER_PORT=9000

# =============================================
# Logging Configuration
# =============================================
LOG_LEVEL="INFO"  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE_MAX_SIZE_MB=10
LOG_BACKUP_COUNT=5

# =============================================
# CORS Configuration
# =============================================
CORS_ALLOW_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
CORS_ALLOW_CREDENTIALS=true
